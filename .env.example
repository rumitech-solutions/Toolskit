# Public site integrations. These values are embedded in the frontend build.
# Leave them blank until the corresponding Google property/account is ready.

# Google Analytics 4 web Measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google AdSense publisher client, e.g. ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT=

# Optional responsive manual ad-unit slot ID created in AdSense.
# Auto ads can still work from VITE_ADSENSE_CLIENT alone when enabled in AdSense.
VITE_ADSENSE_SLOT_AFTER_CONTENT=

# Optional Google Search Console HTML-tag verification value.
VITE_GOOGLE_SITE_VERIFICATION=
